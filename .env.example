# Django / Klints
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — defaults to SQLite when unset
# DATABASE_URL=postgres://user:password@localhost:5432/klints

# CORS (comma-separated origins; ignored in local when CORS_ALLOW_ALL_ORIGINS=True)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth / email verification (frontend URL must match your dev server port)
FRONTEND_VERIFY_URL=http://localhost:8080/verify-email
EMAIL_VERIFICATION_TTL_HOURS=24
FRONTEND_RESET_URL=http://localhost:8082/reset-password
PASSWORD_RESET_TTL_HOURS=24
DEFAULT_FROM_EMAIL=noreply@klints.ai

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=django-db
REDIS_URL=redis://127.0.0.1:6379/1
# Set True only for tests / no-worker local runs
CELERY_TASK_ALWAYS_EAGER=False

# Production / DigitalOcean (put the real values in GitHub secret DEV_ENV_FILE)
# DEBUG=False
# DATABASE_URL=postgres://user:password@host:5432/klints
# CONNECTOR_FERNET_KEY=<fernet-key>
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
# FRONTEND_VERIFY_URL=https://your-frontend.example/verify-email
# CELERY_BROKER_URL=redis://redis:6379/0
# REDIS_URL=redis://redis:6379/1
#
# Domain + TLS (apis.klints.io — nginx + certbot on the droplet):
# ALLOWED_HOSTS=apis.klints.io,<droplet-ip>,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://apis.klints.io
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# Klints Mailer API
MAILER_API_URL=https://klints-mailer.vercel.app/send-email
MAILER_API_TOKEN=change-me

# Shopify OAuth app (credentials from the Shopify Partners dashboard)
SHOPIFY_API_KEY=change-me
SHOPIFY_API_SECRET=change-me
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_API_VERSION=2026-01
SHOPIFY_OAUTH_REDIRECT_URI=https://your-tunnel.example/api/v1/connectors/shopify/callback/
FRONTEND_SHOPIFY_REDIRECT_URL=http://localhost:8080/integrations

# Team invites (frontend accept page must match your dev server port)
FRONTEND_INVITE_URL=http://localhost:8080/invite/accept
INVITE_TTL_DAYS=7

# Email branding (optional — defaults derive origin from FRONTEND_* URLs)
# FRONTEND_APP_ORIGIN=https://klints-frontend.vercel.app
# EMAIL_LOGO_URL=https://klints-frontend.vercel.app/klints-mark.png
# FRONTEND_DCS_URL=http://localhost:8080/dashboard

# Manago.ai API (optional override; default https://app2.manago.ai)
# MANAGO_API_BASE_URL=https://app2.manago.ai
