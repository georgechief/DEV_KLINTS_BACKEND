{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/orchestration_task.schema.json",
  "title": "Orchestration Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "tenant_id",
    "task_type",
    "status",
    "depends_on",
    "priority_inputs",
    "priority_score",
    "wave",
    "capability_dependencies",
    "approval",
    "idempotency_key",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.1"
    },
    "task_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "task_type": {
      "enum": [
        "CONNECT",
        "DISCOVER",
        "SCORE",
        "FIX",
        "ASSESS",
        "PLAN",
        "REPORT",
        "EXPORT",
        "BUILD",
        "QA",
        "HANDOFF"
      ]
    },
    "status": {
      "enum": [
        "PENDING",
        "BLOCKED",
        "READY",
        "IN_PROGRESS",
        "AWAITING_APPROVAL",
        "DONE",
        "FAILED",
        "CANCELLED"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "priority_class": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "priority_inputs": {
      "type": "object",
      "required": [
        "blocker_status",
        "severity_risk",
        "dependency_readiness",
        "effort_impact"
      ],
      "properties": {
        "blocker_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "severity_risk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "dependency_readiness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "effort_impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "priority_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "wave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "capability_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "report_variant": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "FREE_DIAGNOSTIC",
        "PAID_FULL",
        "LIVING",
        null
      ]
    },
    "input_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
