{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/assessment_report.schema.json",
  "title": "Assessment Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "tenant_id",
    "report_version",
    "variant",
    "status",
    "data_as_of",
    "input_snapshot_ids",
    "template_version",
    "content",
    "access_policy",
    "artifacts",
    "payload_hash",
    "created_at",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "report_version": {
      "type": "string"
    },
    "variant": {
      "enum": [
        "FREE_DIAGNOSTIC",
        "PAID_FULL",
        "LIVING"
      ]
    },
    "status": {
      "enum": [
        "REQUESTED",
        "COMPOSING",
        "READY_TO_RENDER",
        "RENDERING",
        "READY",
        "FAILED",
        "EXPIRED",
        "INCOMPLETE"
      ]
    },
    "data_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "input_snapshot_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "template_version": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "required": [
        "dcs",
        "issue_summary",
        "architecture",
        "business_impact",
        "locked_sections"
      ],
      "properties": {
        "dcs": {
          "type": "object",
          "required": [
            "state",
            "headline_score",
            "coverage"
          ],
          "properties": {
            "state": {
              "type": "string"
            },
            "headline_score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "dimension_scores": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "issue_summary": {
          "type": "object"
        },
        "architecture": {
          "type": "object"
        },
        "business_impact": {
          "type": "object"
        },
        "top_issues": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object"
          }
        },
        "remediation": {
          "type": [
            "object",
            "null"
          ]
        },
        "execution_plan": {
          "type": [
            "object",
            "null"
          ]
        },
        "locked_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "access_policy": {
      "type": "object",
      "required": [
        "tenant_scoped",
        "pii_policy",
        "retention_policy_id"
      ],
      "properties": {
        "tenant_scoped": {
          "const": true
        },
        "pii_policy": {
          "const": "AGGREGATE_NO_CONTACT_LEVEL_PII"
        },
        "retention_policy_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "format",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "format": {
            "enum": [
              "PDF",
              "JSON",
              "IN_APP"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "storage_region": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at",
        "created_by"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "locator",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
