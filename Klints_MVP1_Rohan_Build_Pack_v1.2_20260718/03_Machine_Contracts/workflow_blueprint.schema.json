{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/workflow_blueprint.schema.json",
  "title": "Workflow Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blueprint_id",
    "use_case_id",
    "variant_id",
    "release",
    "target_platform",
    "gates",
    "audience",
    "trigger",
    "workflow",
    "measurement",
    "qa",
    "approval",
    "rollback",
    "capability_dependencies",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.1"
    },
    "blueprint_id": {
      "type": "string"
    },
    "use_case_id": {
      "type": "string",
      "pattern": "^UC-[0-9]{2}[A-Z]?$"
    },
    "variant_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "pilot_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "target_platform": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "solution_type": {
      "type": "string"
    },
    "business_objective": {
      "type": "string"
    },
    "configured_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "min_dcs",
        "gating_check_ids"
      ],
      "properties": {
        "min_dcs": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "gating_check_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architecture_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "data_contract": {
      "type": "object"
    },
    "audience": {
      "type": "object"
    },
    "trigger": {
      "type": "object"
    },
    "workflow": {
      "type": "object",
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "node_type",
              "configured_by",
              "executed_by",
              "next"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "node_type": {
                "type": "string"
              },
              "platform_primitive": {
                "type": "string"
              },
              "config": {
                "type": "object"
              },
              "configured_by": {
                "type": "string"
              },
              "executed_by": {
                "type": "string"
              },
              "next": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frequency_policy": {
      "type": "object"
    },
    "collision_policy": {
      "type": "object"
    },
    "content": {
      "type": "object"
    },
    "measurement": {
      "type": "object"
    },
    "qa": {
      "type": "object"
    },
    "approval": {
      "type": "object"
    },
    "rollback": {
      "type": "object"
    },
    "capability_dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "handoff": {
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "parent_use_case_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^UC-[0-9]{2}$"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
