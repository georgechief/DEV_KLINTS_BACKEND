{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/qa_result.schema.json",
  "title": "QA Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qa_run_id",
    "tenant_id",
    "object_id",
    "score",
    "hard_tests",
    "status",
    "evidence",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "qa_run_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "hard_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at",
        "created_by"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "locator",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
