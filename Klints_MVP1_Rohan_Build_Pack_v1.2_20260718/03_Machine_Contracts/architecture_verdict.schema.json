{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/architecture_verdict.schema.json",
  "title": "Architecture Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "assessment_id",
    "mode",
    "asset_verdicts",
    "evidence_coverage",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string"
    },
    "assessment_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "AUGMENT",
        "SELECTIVE_REBUILD",
        "REBUILD",
        "INCOMPLETE"
      ]
    },
    "weighted_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "critical_defects": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "asset_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "verdict",
          "evidence_ids"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "KEEP",
              "KEEP_IMPROVE",
              "FIX_FIRST",
              "CONSOLIDATE",
              "RETIRE_CANDIDATE"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
