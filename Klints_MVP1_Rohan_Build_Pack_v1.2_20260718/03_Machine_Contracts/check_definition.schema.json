{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/check_definition.schema.json",
  "title": "Check Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "dimension",
    "check_type",
    "detection_logic",
    "severity",
    "numeric_weight",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[0-9]{2}$"
    },
    "dimension": {
      "type": "string"
    },
    "check_type": {
      "enum": [
        "RULE_BASED",
        "DRIFT"
      ]
    },
    "detection_logic": {
      "type": "string",
      "minLength": 10
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "Informational"
      ]
    },
    "numeric_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "gating_role": {
      "enum": [
        "GATE",
        "SCORED"
      ]
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
