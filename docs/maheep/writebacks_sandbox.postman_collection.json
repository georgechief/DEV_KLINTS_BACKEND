        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"execute\",\n  \"check_id\": \"CC-03\",\n  \"diff_hash\": \"{{diff_hash}}\",\n  \"max_rows\": 1\n}"
        },
        "url": "{{base_url}}/api/v1/writebacks/run/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.job_id && body.summary && body.summary.executed > 0) {",
              "  pm.collectionVariables.set('job_id', body.job_id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Run rollback",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"rollback\",\n  \"job_id\": \"{{job_id}}\"\n}"
        },
        "url": "{{base_url}}/api/v1/writebacks/run/"
      }
    },
