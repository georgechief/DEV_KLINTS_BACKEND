{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.klints.io/mvp1/check_result.schema.json",
  "title": "Check Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "run_id",
    "check_id",
    "status",
    "confidence",
    "evidence",
    "scoring_model_version",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "NOT_APPLICABLE",
        "NOT_CONNECTED",
        "UNKNOWN"
      ]
    },
    "score_factor": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "numeric_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "confidence_factor": {
      "type": "number",
      "enum": [
        1,
        0.7,
        0.4
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "scoring_model_version": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "source",
        "observed_at"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "value": {},
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_versions",
        "created_at"
      ],
      "properties": {
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
